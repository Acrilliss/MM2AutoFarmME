local function setFarmSettingsOpen(open, instant)
	farmSettingsOpen = open
	if farmSettingsTween then
		farmSettingsTween:Cancel()
		farmSettingsTween = nil
	end

	if open then
		for _, row in ipairs(farmSettingsRows) do
			row.Visible = true
		end
	end

	local targetHeight = open and farmSettingsHeight or 0
	if instant then
		farmSettingsBody.Size = UDim2.new(1, 0, 0, targetHeight)
		if not open then
			for _, row in ipairs(farmSettingsRows) do
				row.Visible = false
			end
		end
	else
		local tween = TweenService:Create(farmSettingsBody, tweenMed, {
			Size = UDim2.new(1, 0, 0, targetHeight),
		})
		farmSettingsTween = tween
		tween.Completed:Connect(function(playbackState)
			if farmSettingsTween == tween then
				farmSettingsTween = nil
			end
			if playbackState == Enum.PlaybackState.Completed and not farmSettingsOpen then
				for _, row in ipairs(farmSettingsRows) do
					row.Visible = false
				end
			end
		end)
		tween:Play()
	end

	farmSettingsHeader.Text = open and "▾ Настройки автофарма" or "▸ Настройки автофарма"
end


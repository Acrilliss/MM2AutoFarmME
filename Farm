	-- ============================ Role data ============================
	local RoleData = {}
	function RoleData.infer(target)
		local character = target.Character
		if not character then return end
		for _, tool in ipairs(character:GetChildren()) do
			if not tool:IsA("Tool") then continue end
			local name = string.lower(tool.Name)
			if string.find(name, "knife", 1, true) then return "Murderer" end
			if string.find(name, "gun", 1, true) then return "Sheriff" end
		end
	end
	function RoleData.source(target)
		local state = target.state
		if state.source then return state.source end
		local storage = target.storage
		local function fromFolder(folder)
			return RoleData._load(target.environment, folder and folder:FindFirstChild("CurrentRoundClient"))
		end
		state.source = fromFolder(storage:FindFirstChild("Modules"))
			or RoleData._load(target.environment, storage:FindFirstChild("CurrentRoundClient"))
			or fromFolder(storage:FindFirstChild("Client"))
		if state.source then return state.source end
		local modules = storage:FindFirstChild("Modules")
		local client = modules and modules:FindFirstChild("Client")
		state.source = fromFolder(client)
		return state.source
	end
	function RoleData.refresh(target)
		local state = target.state
		local source = RoleData.source(target)
		if source then
			local ok, roles = target.environment.pcall(function() return source.GetLatestPlayerData() end)
			if ok and type(roles) == "table" then state.roles = roles end
			return
		end
		local roles = {}
		for _, targetPlayer in ipairs(target.players:GetPlayers()) do
			local role = RoleData.infer(targetPlayer)
			if not role then continue end
			local character = targetPlayer.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local dead = humanoid and humanoid.Health <= 0 or false
			roles[targetPlayer.Name] = {Role = role, Dead = dead, Killed = false}
		end
		state.roles = roles
	end
	function RoleData._load(env, module)
		if not module or not module:IsA("ModuleScript") then return end
		local ok, source = env.pcall(env.require, module)
		if not ok or type(source) ~= "table" or type(source.GetLatestPlayerData) ~= "function" then return end
		return source
	end

	local RoleCache = {}
	function RoleCache.create(target)
		local env = target.environment
		local state = target.state
		state.refreshing = false
		state.lastRefresh = 0
		return function()
			if not state.refreshing and env.os.clock() - state.lastRefresh >= 0.25 then
				state.refreshing = true
				env.task.spawn(function()
					env.pcall(target.refresh)
					state.lastRefresh = env.os.clock()
					state.refreshing = false
				end)
			end
			return state.roles
		end
	end


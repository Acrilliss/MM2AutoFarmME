	local collectedUntil = farmCollected[part]
	if collectedUntil then
		if collectedUntil > now then
			return nil
		end
		farmCollected[part] = nil
	end

	local record = farmRecords[part]
	if record then
		record.pos = part.Position
		return record
	end

	local size = part.Size
	record = {
		part = part,
		pos = part.Position,
		radius = math.min(size.X, size.Y, size.Z) * 0.5,
		readyAt = 0,
		attempts = 0,
		best = math.huge,
		progressAt = 0,
	}
	farmRecords[part] = record
	return record
end

local function farmDropRecord(part)
	if not farmRecords[part] then
		return
	end
	farmRecords[part] = nil
	if farmTarget and farmTarget.part == part then
		farmTarget = nil
	end
end

local function farmNewScanner()
	local stack = { workspace }
	local processed = 0

	return coroutine.create(function()
		while #stack > 0 do
			local node = table.remove(stack)
			local children = node:GetChildren()
			if node ~= workspace.CurrentCamera and node ~= workspace.Terrain then
				local record = farmRecords[node]
				if record then
					record.pos = node.Position
				elseif farmMatches(node) then
					farmAddRecord(node)
				end
				for index = #children, 1, -1 do
					stack[#stack + 1] = children[index]
				end
			end
			processed = processed + 1
			if processed % FARM_SCAN_CHUNK == 0 then
				coroutine.yield()
			end
		end
	end)
end

local function farmFindTarget(position)
	local now = os.clock()
	local best = {}

	for part, record in pairs(farmRecords) do
		if not part.Parent then
			farmRecords[part] = nil
		elseif record.readyAt <= now then
			local delta = record.pos - position
			local distance = delta.Magnitude
			-- Не берём цели сильно выше/ниже персонажа: именно из-за них
			-- он улетал в небо или проваливался далеко от карты.
			if distance <= FARM_MAX_RANGE
				and math.abs(delta.Y) <= FARM_MAX_Y_DIFF then
				local count = #best
				if count < 4 or distance < best[count].distance then
					best[count + 1] = { record = record, distance = distance }
					local index = count + 1
					while index > 1 and best[index].distance < best[index - 1].distance do
						best[index], best[index - 1] = best[index - 1], best[index]
						index = index - 1
					end
					if #best > 4 then
						best[#best] = nil
					end
				end
			end
		end
	end

	for _, item in ipairs(best) do
		local part = item.record.part
		if part.Parent and part.Transparency < 0.99 and part.CanTouch then
			item.record.pos = part.Position
			return item.record
		end
		farmRecords[part] = nil
	end

	return nil
end

local function farmTrackCharacter(character)
	if farmCharacterConnection then
		farmCharacterConnection:Disconnect()
		farmCharacterConnection = nil
	end

	for part in pairs(farmCollisions) do
		if not part.Parent then
			farmCollisions[part] = nil
		end
	end

	farmCharacterParts = {}

	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			farmCharacterParts[part] = true
			if farmCollisions[part] == nil then
				farmCollisions[part] = part.CanCollide
			end
		end
	end

	farmCharacterConnection = character.DescendantAdded:Connect(function(part)
		if part:IsA("BasePart") then
			farmCharacterParts[part] = true
			if farmCollisions[part] == nil then
				farmCollisions[part] = part.CanCollide
			end
		end
	end)
end

local function farmClearAlign()
	if farmAlign then
		farmAlign:Destroy()
		farmAlign = nil
	end
	if farmOrientation then
		farmOrientation:Destroy()
		farmOrientation = nil
	end
	if farmAttachment then
		farmAttachment:Destroy()
		farmAttachment = nil
	end
end

local function farmRestoreCollisions()
	for part, canCollide in pairs(farmCollisions) do
		if part.Parent then
			part.CanCollide = canCollide
		else
			farmCollisions[part] = nil
		end
	end
end

local function farmEnsureAlign(hrp)
	if farmAlign and farmAlign.Parent == hrp
		and farmOrientation and farmOrientation.Parent == hrp then
		return
	end
	farmClearAlign()

	farmAttachment = Instance.new("Attachment")
	farmAttachment.Parent = hrp

	farmAlign = Instance.new("AlignPosition")
	farmAlign.Mode = Enum.PositionAlignmentMode.OneAttachment
	farmAlign.Attachment0 = farmAttachment
	farmAlign.MaxForce = 1e6
	farmAlign.Responsiveness = 200
	farmAlign.MaxVelocity = FARM_SPEED
	farmAlign.Position = hrp.Position
	farmAlign.Parent = hrp

	farmOrientation = Instance.new("AlignOrientation")
	farmOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	farmOrientation.Attachment0 = farmAttachment
	farmOrientation.MaxTorque = 1e6
	farmOrientation.Responsiveness = 60
	farmOrientation.CFrame = hrp.CFrame
	farmOrientation.Parent = hrp
end

-- Поза «лежа на спине»: заваливаем персонажа назад, лицом вверх.
local function farmLieFrame(position)
	return CFrame.new(position) * CFrame.Angles(math.rad(FARM_LIE_ANGLE), 0, 0)
end

local function farmTouch(part, hrp)
	if type(firetouchinterest) ~= "function" then
		return false
	end
	pcall(firetouchinterest, hrp, part, 0)
	pcall(firetouchinterest, hrp, part, 1)
	return true
end

local function farmStatsSnapshot()
	local snapshot = {}
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		return snapshot
	end
	for _, child in ipairs(stats:GetChildren()) do
		if child:IsA("ValueBase") then
			local value = tonumber(child.Value)
			if value then
				snapshot[child.Name] = value
			end
		end
	end
	return snapshot
end

local function farmNoteCollection()
	local snapshot = farmStatsSnapshot()
	local gained = false
	local capped = false
	local previousSnapshot = farmStatsLast

	if previousSnapshot then
		for name, value in pairs(snapshot) do
			local previous = previousSnapshot[name]
			if previous then
				if value > previous then
					gained = true
					farmStatsGrowing[name] = true
				elseif value == previous
					and value == FARM_BAG_FULL
					and farmStatsGrowing[name] then
					capped = true
				end
			end
		end
	end
	farmStatsLast = snapshot

	if gained then
		farmCapStuck = 0
		farmFullLatch = false
	elseif capped then
		farmCapStuck = farmCapStuck + 1
	else
		farmCapStuck = 0
	end

	return farmCapStuck >= 2
end

local farmHudCounters = setmetatable({}, { __mode = "k" })

local farmFullWords = {
	"полон", -- полон / переполнен
	"полн", -- полный / заполнен
	"нет места",
	"full",
	"no space",
}

local farmBagWords = {
	"меш",
	"сумк",
	"конфет",
	"койн",
	"инвентар",
	"candy",
	"candies",
	"coin",
	"bag",
	"inventory",
}

local function farmTextHasAny(text, words)
	if type(text) ~= "string" or #text == 0 or #text > 64 then
		return false
	end
	local lowered = farmLower(text)
	for _, word in ipairs(words) do
		if string.find(lowered, word, 1, true) then
			return true
		end
	end
	return false
end

local function farmTextHasBag(text)
	return farmTextHasAny(text, farmBagWords)
end

local function farmTextHasFull(text)
	if type(text) ~= "string" or #text == 0 or #text > 64 then
		return false
	end

	local lowered = farmLower(text)
	-- Явные признаки полного мешка.
	if string.find(lowered, "полон", 1, true)
		or string.find(lowered, "переполн", 1, true)
		or string.find(lowered, "нет места", 1, true)
		or string.find(lowered, "no space", 1, true) then
		return true
	end

	-- «полный»/«full» засчитываем только рядом со словом про мешок:
	-- иначе любая надпись вида «Full» в интерфейсе даёт ложный сброс.
	if farmTextHasBag(text)
		and (string.find(lowered, "полн", 1, true)
			or string.find(lowered, "full", 1, true)) then
		return true
	end

	return false
end

-- Возвращает true, если число в надписи доросло до «полного мешка»
-- и держится на этом значении (просто проходящее число, например таймер, не считается).
local function farmHudTrack(label, number)
	local value = tonumber(number)
	if not value then
		return nil, false, false
	end

	local state = farmHudCounters[label]
	if not state then
		state = { value = value, grew = false }
		farmHudCounters[label] = state
		return value, false, false
	end

	local previous = state.value
	if value < previous then
		state.value = value
		state.grew = false
	elseif value > previous then
		state.value = value
		state.grew = true
	end

	return value, state.grew, value == previous
end

local function farmHudCounter(label, number)
	local value, grew, same = farmHudTrack(label, number)
	return value ~= nil and value == FARM_BAG_FULL and grew and same
end

local function farmFraction(text)
	local lowered = farmLower(text)
	local current, maximum = string.match(lowered, "(%d+)%s*/%s*(%d+)")
	if current then
		return tonumber(current), tonumber(maximum), true
	end
	current, maximum = string.match(lowered, "(%d+)%s*из%s*(%d+)")
	if not current then
		current, maximum = string.match(lowered, "(%d+)%s+of%s+(%d+)")
	end
	return tonumber(current), tonumber(maximum), false
end

local function farmHudCheckText(label, text)
	if type(text) ~= "string" or #text == 0 or #text > 64 then
		return false
	end

	-- «Мешок полон», «Bag Full», «нет места» и т.п.
	if farmTextHasFull(text) then
		return true
	end

	-- «50/50», «47 / 50», «50 из 50»
	local cur, max, slash = farmFraction(text)
	if cur and max and max > 0 then
		local bagFraction = (slash and max == FARM_BAG_FULL) or farmTextHasBag(text)
		if bagFraction then
			local value, grew, same = farmHudTrack(label, cur)
			if value and value >= max and grew and same then
				return true
			end
		end
	end

	local trimmed = string.match(text, "^%s*(.-)%s*$") or text

	-- число целиком: «50»
	if tonumber(trimmed) then
		return farmHudCounter(label, trimmed)
	end

	-- «🍬 50», «(50)» — одно число без букв
	local only = string.match(trimmed, "^[^%d]*(%d+)[^%d]*$")
	if only
		and not string.find(trimmed, "%%")
		and not string.find(trimmed, "%a")
		and not string.find(trimmed, "[\208\209]") then
		return farmHudCounter(label, only)
	end

	-- «Конфеты: 50», «Coins 50»
	if farmTextHasBag(trimmed) then
		local number = string.match(trimmed, "(%d+)")
		if number then
			return farmHudCounter(label, number)
		end
	end

	return false
end

local function farmHudLabelVisible(label)
	local node = label
	while node and node ~= playerGui do
		if node:IsA("GuiObject") and not node.Visible then
			return false
		end
		node = node.Parent
	end
	return true
end

local function farmHudCollect(now)
	-- Кэш короткий: сообщение «мешок полон» может появиться и исчезнуть
	-- за пару секунд, нельзя сканировать HUD раз в 2 секунды.
	if now - farmHudCacheAt < 0.25 then
		return farmHudCache
	end
	farmHudCacheAt = now
	local list = {}
	local function scan(node)
		for _, child in ipairs(node:GetChildren()) do
			if child ~= gui then
				if child:IsA("GuiObject") then
					if child.Visible then
						if child:IsA("TextLabel") or child:IsA("TextButton") then
							list[#list + 1] = child
						end
						scan(child)
					end
				else
					scan(child)
				end
			end
		end
	end
	scan(playerGui)
	farmHudCache = list
	return list
end

local function farmHudFull(now)
	if now - farmHudAt < 0.5 then
		return false
	end
	farmHudAt = now

	local hit = false
	local strongHit = false
	for _, label in ipairs(farmHudCollect(now)) do
		if label.Parent
			and label.Visible
			and label.TextTransparency < 0.9
			and farmHudLabelVisible(label)
			and farmHudCheckText(label, label.Text) then
			hit = true
			-- Явное «мешок полон / bag full / нет места» может висеть
			-- меньше секунды. Такое сообщение засчитываем сразу,
			-- иначе авторесет вообще не срабатывает.
			if farmTextHasFull(label.Text) then
				strongHit = true
			end
		end
	end

	if hit then
		farmHudHits = farmHudHits + 1
		farmHudClear = 0
	else
		farmHudHits = 0
		farmHudClear = farmHudClear + 1
		if farmHudClear >= 2 then
			farmFullLatch = false
		end
	end

	if (strongHit or farmHudHits >= 2) and not farmFullLatch then
		farmFullLatch = true
		farmFullNote = "мешок полон: " .. tostring(FARM_BAG_FULL) .. " (HUD)"
		return true
	end
	return false
end

-- Определение роли только по явным данным игры (атрибуты/StringValue).
-- Инструменты и HUD не используем: они давали ложное «убийца»
-- и блокировали авторесет.
local function farmRoleFromText(text)
	if type(text) ~= "string" or #text == 0 or #text > 64 then
		return nil
	end
	local lowered = farmLower(text)
	for _, word in ipairs(FARM_ROLE_WORDS.text.murderer) do
		if string.find(lowered, word, 1, true) then
			return "murderer"
		end
	end
	for _, word in ipairs(FARM_ROLE_WORDS.text.sheriff) do
		if string.find(lowered, word, 1, true) then
			return "sheriff"
		end
	end
	for _, word in ipairs(FARM_ROLE_WORDS.text.innocent) do
		if string.find(lowered, word, 1, true) then
			return "innocent"
		end
	end
	return nil
end

local function farmUpdateRole(now)
	if now - farmRoleAt < 0.5 then
		return farmRole
	end
	farmRoleAt = now

	local previousRole = farmRole
	local character = player.Character

	local attrRole
	for _, node in ipairs({ player, character }) do
		if node then
			local value = node:GetAttribute("Role")
				or node:GetAttribute("role")
				or node:GetAttribute("RoleName")
			if type(value) == "string" then
				attrRole = farmRoleFromText(value)
				if attrRole then
					break
				end
			end
		end
	end

	if not attrRole then
		for _, node in ipairs({ player, character }) do
			if node then
				for _, child in ipairs(node:GetChildren()) do
					if child:IsA("StringValue")
						and (child.Name == "Role" or child.Name == "RoleName") then
						attrRole = farmRoleFromText(child.Value)
						if attrRole then
							break
						end
					end
				end
			end
			if attrRole then
				break
			end
		end
	end

	if attrRole then
		farmRole = attrRole
	else
		-- Игра не сообщает роль — считаем неизвестной, ресет разрешён.
		farmRole = "unknown"
	end

	if farmRole ~= previousRole then
		-- Смена роли: даём ресету шанс сработать заново.
		farmFullLatch = false
	end

	return farmRole
end

local function farmKillCharacter()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not humanoid then
		return false
	end

	-- Уже мёртв — значит, респавн и так запущен. Раньше это считалось
	-- ошибкой, из-за чего авторесет «залипал».
	if humanoid.Health <= 0 then
		return true
	end

	local function dead()
		return humanoid.Health <= 0
	end

	pcall(function()
		humanoid.Health = 0
	end)
	if dead() then
		return true
	end

	pcall(function()
		humanoid:TakeDamage(humanoid.MaxHealth * 10 + 1e6)
	end)
	if dead() then
		return true
	end

	pcall(function()
		humanoid:ChangeState(Enum.HumanoidStateType.Dead)
	end)
	if dead() then
		return true
	end

	pcall(function()
		character:BreakJoints()
	end)
	if dead() then
		return true
	end

	return false
end


local function farmRequestReset(now, note)
	if now < farmResetAt then
		return false
	end

	-- Убийце ресет не нужен (и вреден): он теряет роль/раунд.
	-- Проверяем роль принудительно, без 0.5-секундного кэша,
	-- чтобы не ресетнуть убийцу из-за устаревшего «unknown».
	farmRoleAt = 0
	farmUpdateRole(now)
	if farmRole == "murderer" then
		farmFullNote = "ты убийца — ресет не нужен"
		return false
	end

	local character = player.Character
	farmFailStreak = 0
	farmFailParts = setmetatable({}, { __mode = "k" })
	farmPendingTouches = {}
	farmCapStuck = 0
	farmHudHits = 0
	farmHudClear = 0
	farmHudCacheAt = -math.huge
	farmHudCache = {}
	farmHudCounters = setmetatable({}, { __mode = "k" })
	farmStatsGrowing = {}
	farmStatsLast = farmStatsSnapshot()
	farmWatchAt = 0
	farmWatchLast = nil
	farmStatGainAt = {}
	farmTarget = nil
	farmNextSelectAt = 0

	for _, record in pairs(farmRecords) do
		record.readyAt = 0
		record.attempts = 0
		record.best = math.huge
	end

	if not farmKillCharacter() then
		-- Убить не вышло. Раньше тут всё равно тратился 10-секундный
		-- кулдаун и взводился latch — авторесет больше не пробовал.
		farmFullLatch = false
		farmResetAt = now + 1
		farmFullNote = "не смог зареспавнить"
		return false
	end

	farmResetAt = now + FARM_RESET_COOLDOWN
	farmFullLatch = true
	farmFullNote = note or ""

	-- Счётчик увеличиваем только после того, как убедимся, что персонаж
	-- реально сменился/возродился (проверка в farmUpdate).
	farmResetPendingAt = now
	farmResetPendingCharacter = character
	farmResetSawDead = false
	farmResetDeadAt = 0
	return true
end

local function farmResumeScanner(now)
	if farmScanner then
		if coroutine.status(farmScanner) == "suspended" then
			local ok = coroutine.resume(farmScanner)
			if not ok then
				farmScanner = nil
			end
			return
		end
		farmScanner = nil
	end

	if now >= farmNextSweepAt then
		farmScanner = farmNewScanner()
		farmNextSweepAt = now + FARM_SWEEP_INTERVAL
	end
end


local function farmUpdate()
	if not farmRunning then
		return
	end

	local now = os.clock()
	farmResumeScanner(now)
	farmUpdateRole(now)

	-- Проверка, что авторесет реально сработал. Клиентский kill иногда
	-- не принимается сервером — тогда персонаж не меняется, и раньше
	-- авторесет молча считался успешным и больше не пытался.
	if farmResetPendingAt > 0 then
		local current = player.Character
		local currentHumanoid = current and current:FindFirstChildOfClass("Humanoid")
		if current ~= farmResetPendingCharacter
			or not currentHumanoid
			or currentHumanoid.Health <= 0 then
			if not farmResetSawDead then
				farmResetSawDead = true
				farmResetDeadAt = now
			end
		end

		if current ~= farmResetPendingCharacter then
			-- персонаж заменился — респавн точно прошёл
			farmResetPendingAt = 0
			farmResetSawDead = false
			farmResetCount = farmResetCount + 1
		elseif farmResetSawDead and currentHumanoid and currentHumanoid.Health > 0 then
			-- тот же персонаж ожил (респавн на месте). Требуем, чтобы он
			-- пробыл мёртвым хотя бы полсекунды — иначе это просто
			-- сервер вернул здоровье, и kill не сработал.
			if now - farmResetDeadAt >= 0.5 then
				farmResetPendingAt = 0
				farmResetSawDead = false
				farmResetCount = farmResetCount + 1
			else
				farmResetPendingAt = 0
				farmResetSawDead = false
				farmFullLatch = false
				farmResetAt = now + 1
				farmFullNote = "ресет не сработал"
			end
		elseif now - farmResetPendingAt > 8 then
			-- персонаж так и не умер — kill не сработал, пробуем позже
			farmResetPendingAt = 0
			farmResetSawDead = false
			farmFullLatch = false
			farmResetAt = now + 1
			farmFullNote = "ресет не сработал"
		end
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local hrp = character and character:FindFirstChild("HumanoidRootPart")

	if not character or not humanoid or not hrp or humanoid.Health <= 0 then
		if farmLastCharacter then
			farmLastCharacter = nil
			farmTarget = nil
			farmClearAlign()
			farmRestoreCollisions()
		end
		return
	end

	if farmLastCharacter ~= character then
		farmLastCharacter = character
		farmTarget = nil
		farmNextSelectAt = 0
		farmClearAlign()
		farmTrackCharacter(character)
	end

	-- Резервное определение полного мешка. Если игра не пишет
	-- «мешок полон» текстом, смотрим на счётчик: он дошёл до лимита
	-- и не растёт 8 секунд — значит, мешок полон.
	if now - farmWatchAt >= 1 then
		farmWatchAt = now
		local snapshot = farmStatsSnapshot()
		for name, value in pairs(snapshot) do
			local previous = farmWatchLast and farmWatchLast[name]
			if previous and value > previous then
				farmStatGainAt[name] = now
			elseif previous
				and value == previous
				and value == FARM_BAG_FULL
				and farmStatGainAt[name]
				and now - farmStatGainAt[name] >= 8
				and farmAutoReset
				and not farmFullLatch then
				farmWatchLast = snapshot
				farmRequestReset(now, "счётчик " .. name .. " замер на " .. tostring(value))
				return
			end
		end
		farmWatchLast = snapshot
	end

	if farmAutoReset and farmHudFull(now) then
		-- Роль проверит сам farmRequestReset и, если это убийца,
		-- покажет причину в статусе.
		farmRequestReset(now, farmFullNote ~= "" and farmFullNote or "написано «полный мешок»")
		return
	end

	for part in pairs(farmCharacterParts) do
		if part.Parent then
			if part.CanCollide then
				part.CanCollide = false
			end
		else
			farmCharacterParts[part] = nil
		end
	end

	if not humanoid.PlatformStand then
		humanoid.PlatformStand = true
	end
	if humanoid.AutoRotate then
		humanoid.AutoRotate = false
	end

	farmEnsureAlign(hrp)
	farmAlign.MaxVelocity = FARM_SPEED
	if farmOrientation then
		farmOrientation.CFrame = farmLieFrame(hrp.Position)
	end

	for index = #farmPendingTouches, 1, -1 do
		local pending = farmPendingTouches[index]
		local part = pending.part
		local collected = not part.Parent
			or part.Transparency >= 0.99
			or (part.Position - pending.pos).Magnitude > FARM_DRIFT
		if collected then
			table.remove(farmPendingTouches, index)
			farmFailStreak = 0
			farmFailParts = setmetatable({}, { __mode = "k" })
			farmRecords[part] = nil
			farmCollected[part] = now + FARM_COLLECTED_TTL
			local capped = farmNoteCollection()
			if capped and farmAutoReset and not farmFullLatch then
				farmRequestReset(now, "счётчик замер на " .. tostring(FARM_BAG_FULL))
				return
			end
			if farmTarget and farmTarget.part == part then
				farmTarget = nil
			end
		elseif now - pending.at >= FARM_TOUCH_CHECK then
			table.remove(farmPendingTouches, index)
			if not farmFailParts[part] then
				farmFailParts[part] = true
				farmFailStreak = farmFailStreak + 1
			end
		end
	end

	if farmTarget then
		local part = farmTarget.part
		if not part.Parent then
			farmRecords[part] = nil
			farmTarget = nil
		elseif (part.Position - farmTarget.anchor).Magnitude > FARM_DRIFT then
			-- конфета уехала (её уже подобрали / унесли) — за ней не гонимся
			farmTarget.pos = part.Position
			farmTarget.readyAt = now + 10
			farmTarget = nil
		else
			farmTarget.pos = part.Position
			local distance = (farmTarget.pos - hrp.Position).Magnitude
			if distance < farmTarget.best - 0.5 then
				farmTarget.best = distance
				farmTarget.progressAt = now
			elseif now - farmTarget.progressAt > 3 then
				farmTarget.readyAt = now + 10
				farmTarget = nil
			end
		end
	end

	if not farmTarget and now >= farmNextSelectAt then
		farmTarget = farmFindTarget(hrp.Position)
		if farmTarget then
			farmTarget.anchor = farmTarget.pos
			farmTarget.best = (farmTarget.pos - hrp.Position).Magnitude
			farmTarget.progressAt = now
			farmNextSelectAt = now
		else
			farmNextSelectAt = now + 0.25
		end
	end

	local targetPos = farmTarget and farmTarget.pos or hrp.Position
	local distance = (targetPos - hrp.Position).Magnitude
	local reach = FARM_REACH + (farmTarget and farmTarget.radius or 0)

	if farmTarget and distance <= reach then
		local part = farmTarget.part
		local touchPos = part.Position
		local fireStarted = farmTouch(part, hrp)
		farmTarget.attempts = farmTarget.attempts + 1
		farmTarget.readyAt = now + FARM_TOUCH_CHECK + FARM_RETOUCH * math.min(farmTarget.attempts, 4)
		if fireStarted then
			farmPendingTouches[#farmPendingTouches + 1] = {
				part = part,
				pos = touchPos,
				at = now,
			}
			if #farmPendingTouches > 8 then
				table.remove(farmPendingTouches, 1)
			end
		end
		farmTarget = nil
		farmNextSelectAt = now
	else
		farmAlign.MaxVelocity = FARM_SPEED
		if math.abs(targetPos.Y - hrp.Position.Y) > FARM_MAX_Y_DIFF then
			-- Цель резко выше или ниже: движемся только по горизонтали,
			-- иначе персонаж улетает вверх / уходит под карту.
			farmAlign.Position = Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z)
		else
			farmAlign.Position = targetPos
		end
	end
end

local function farmStop()
	farmRunning = false

	if farmStepConnection then
		farmStepConnection:Disconnect()
		farmStepConnection = nil
	end
	if farmAddedConnection then
		farmAddedConnection:Disconnect()
		farmAddedConnection = nil
	end
	if farmRemovedConnection then
		farmRemovedConnection:Disconnect()
		farmRemovedConnection = nil
	end
	if farmCharacterConnection then
		farmCharacterConnection:Disconnect()
		farmCharacterConnection = nil
	end

	farmScanner = nil
	farmTarget = nil
	farmLastCharacter = nil
	farmPendingTouches = {}
	farmCollected = setmetatable({}, { __mode = "k" })
	farmFailParts = setmetatable({}, { __mode = "k" })
	farmFailStreak = 0
	farmHudHits = 0
	farmHudClear = 0
	farmFullLatch = false
	farmCapStuck = 0
	farmStatsGrowing = {}
	farmResetPendingAt = 0
	farmResetPendingCharacter = nil
	farmResetSawDead = false
	farmResetDeadAt = 0
	farmClearAlign()
	farmRestoreCollisions()
	farmCollisions = {}
	farmCharacterParts = {}
	farmRecords = {}

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.PlatformStand = false
		humanoid.AutoRotate = true
	end
end

local function farmStart()
	if farmRunning then
		farmStop()
	end

	farmRunning = true
	farmRecords = {}
	farmTarget = nil
	farmPendingTouches = {}
	farmFailParts = setmetatable({}, { __mode = "k" })
	farmFailStreak = 0
	farmHudHits = 0
	farmHudClear = 0
	farmHudCacheAt = -math.huge
	farmHudCache = {}
	farmFullLatch = false
	farmCapStuck = 0
	farmStatsGrowing = {}
	farmStatsLast = farmStatsSnapshot()
	farmResetAt = 0
	farmResetPendingAt = 0
	farmResetPendingCharacter = nil
	farmResetSawDead = false
	farmResetDeadAt = 0
	farmScanner = farmNewScanner()
	farmNextSweepAt = os.clock() + FARM_SWEEP_INTERVAL

	farmAddedConnection = workspace.DescendantAdded:Connect(function(part)
		if farmRunning and farmMatches(part) then
			farmAddRecord(part)
		end
	end)
	farmRemovedConnection = workspace.DescendantRemoving:Connect(function(part)
		farmDropRecord(part)
	end)

	farmStepConnection = RunService.Stepped:Connect(farmUpdate)
end


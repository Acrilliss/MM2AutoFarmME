-- string.lower в Roblox не трогает кириллицу, поэтому опускаем регистр сами.
local function farmLower(text)
	local lowered = string.lower(text)
	lowered = string.gsub(lowered, "\208([\144-\159])", function(second)
		return "\208" .. string.char(string.byte(second) + 32)
	end)
	lowered = string.gsub(lowered, "\208([\160-\175])", function(second)
		return "\209" .. string.char(string.byte(second) - 32)
	end)
	lowered = string.gsub(lowered, "\208\129", "\209\145")
	return lowered
end

local function farmMatches(part)
	if not part:IsA("BasePart") then
		return false
	end

	local name = farmLower(part.Name)
	local parent = part.Parent
	local parentName = parent and farmLower(parent.Name) or ""

	local matched = false
	for index = 1, #FARM_WORDS do
		local word = FARM_WORDS[index]
		if string.find(name, word, 1, true) or string.find(parentName, word, 1, true) then
			matched = true
			break
		end
	end
	if not matched then
		return false
	end

	for index = 1, #FARM_IGNORED do
		local word = FARM_IGNORED[index]
		if string.find(name, word, 1, true) or string.find(parentName, word, 1, true) then
			return false
		end
	end

	local character = player.Character
	if character and part:IsDescendantOf(character) then
		return false
	end

	local ancestor = part:FindFirstAncestorOfClass("Model")
	if ancestor and ancestor:FindFirstChildOfClass("Humanoid") then
		return false
	end

	if math.max(part.Size.X, part.Size.Y, part.Size.Z) > 50 then
		return false
	end

	return true
end


		environment.task.spawn(function() state.busy = true; pcall(BoxFarm.open, context, state); state.busy = false end)
	end})
	environment.task.spawn(function()
		while context.isAlive() do
			environment.task.wait(0.5)
			pcall(function()
				local box = BoxFarm.find(context, state, settings.id)
				local currency, _, fallback = BoxFarm.currency(context, state, box)
				currency = currency or fallback
				local balance = currency and tostring(math.floor(BoxFarm.balance(context, state, currency))) .. " "
					.. context.translation.tr(BOX_LABELS[currency] or currency) or "-"
				local values = {Opened = tostring(state.opened), Status = context.translation.tr(state.state), Balance = balance, ["Last Drop"] = state.lastName}
				for name, card in cards do if card and values[name] then card:Set(values[name]) end end
			end)
		end
	end)
end



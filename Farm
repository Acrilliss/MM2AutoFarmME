	local page = pulseFarmPage
	local order = 0
	local function nextOrder()
		order += 1
		return order
	end

	-- ============================ UI helpers ============================
	local function tone(name)
		if name == "Warning" then return Color3.fromRGB(255, 176, 32) end
		if name == "Success" then return Color3.fromRGB(88, 214, 141) end
		if name == "Info" then return Color3.fromRGB(96, 170, 255) end
		if name == "Accent" then return THEME.accent end
		return THEME.text
	end

	local activeToasts = {}
	local function toast(options)
		options = type(options) == "table" and options or {}
		for index = #activeToasts, 1, -1 do
			if not activeToasts[index].Parent then table.remove(activeToasts, index) end
		end
		local frame = Instance.new("Frame")
		frame.AnchorPoint = Vector2.new(1, 1)
		frame.Position = UDim2.new(1, -18, 1, -18 - #activeToasts * 62)
		frame.Size = UDim2.fromOffset(240, 54)

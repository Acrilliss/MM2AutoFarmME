	stripLayout.FillDirection = Enum.FillDirection.Horizontal
	stripLayout.Padding = UDim.new(0, 8)
	stripLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	stripLayout.Parent = strip

	local palette = {
		Color3.fromRGB(112, 96, 255),
		Color3.fromRGB(64, 132, 255),
		Color3.fromRGB(46, 196, 182),
		Color3.fromRGB(76, 200, 120),
		Color3.fromRGB(255, 150, 60),
		Color3.fromRGB(240, 80, 120),
	}

	local swatches = {}

	for _, color in ipairs(palette) do
		local swatch = Instance.new("TextButton")
		swatch.Size = UDim2.fromOffset(24, 24)
		swatch.BackgroundColor3 = color
		swatch.AutoButtonColor = false
		swatch.Text = ""
		swatch.Parent = strip
		Instance.new("UICorner", swatch).CornerRadius = UDim.new(1, 0)

		local outline = Instance.new("UIStroke")
		outline.Color = Color3.fromRGB(255, 255, 255)
		outline.Thickness = 2
		outline.Transparency = 1
		outline.Parent = swatch

		swatch.Activated:Connect(function()
			setAccent(color)
			for _, other in ipairs(swatches) do
				local stroke = other:FindFirstChildOfClass("UIStroke")
				if stroke then
					stroke.Transparency = other == swatch and 0 or 1
				end
			end
		end)

		table.insert(swatches, swatch)
	end

	local first = swatches[1]
	local firstStroke = first and first:FindFirstChildOfClass("UIStroke")
	if firstStroke then
		firstStroke.Transparency = 0
	end

	return row

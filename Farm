local tabs = {}
local pages = {}
local activeTab

local function selectTab(name)
	if activeTab == name then
		return
	end
	activeTab = name
	for tabName, button in pairs(tabs) do
		local selected = tabName == name
		TweenService:Create(button, tweenFast, {
			BackgroundColor3 = selected and THEME.accent or THEME.surface,
			TextColor3 = selected and Color3.fromRGB(255, 255, 255) or THEME.muted,
		}):Play()
	end
	for pageName, page in pairs(pages) do
		page.Visible = pageName == name
	end
end

local function refreshTabs()
	for tabName, button in pairs(tabs) do
		local selected = tabName == activeTab
		button.BackgroundColor3 = selected and THEME.accent or THEME.surface
		button.TextColor3 = selected and Color3.fromRGB(255, 255, 255) or THEME.muted
	end
end

local function setAccent(color)
	THEME.accent = color
	for _, listener in ipairs(accentListeners) do
		listener()
	end
	refreshTabs()
end


	stroke.Color = THEME.accent
	stroke.Thickness = 1
	stroke.Transparency = 0.6
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = button

	local state = default

	local function render()
		button.TextColor3 = state and Color3.fromRGB(255, 255, 255) or THEME.accent
		stroke.Transparency = state and 1 or 0.6
		TweenService:Create(button, tweenFast, {
			BackgroundColor3 = state and THEME.accent or THEME.surface,
		}):Play()
	end

	button.MouseEnter:Connect(function()
		if not state then
			TweenService:Create(button, tweenFast, { BackgroundColor3 = THEME.surfaceSoft }):Play()
		end
	end)
	button.MouseLeave:Connect(function()
		if not state then
			TweenService:Create(button, tweenFast, { BackgroundColor3 = THEME.surface }):Play()
		end
	end)
	button.Activated:Connect(function()
		state = not state
		render()
		callback(state)
	end)

	table.insert(accentListeners, function()
		stroke.Color = THEME.accent
		render()
	end)

	render()
	return button
end

local draggingWindow = false
local dragStart
local startPosition

header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		draggingWindow = true
		dragStart = input.Position
		startPosition = root.Position
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if draggingWindow
		and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		root.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
		shadow.Position = root.Position
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		draggingWindow = false
	end
end)


	local dropWatch = {active = false, parts = setmetatable({}, {__mode = "k"})}
	local function rememberDrop(part)
		if part.Name == "GunDrop" and part:IsA("BasePart") then dropWatch.parts[part] = true end
	end
	local function findDrop()
		if not dropWatch.active then
			dropWatch.active = true
			workspace.DescendantAdded:Connect(rememberDrop)
			for _, part in ipairs(workspace:GetDescendants()) do rememberDrop(part) end
		end
		for part in pairs(dropWatch.parts) do
			if part.Parent and part.Name == "GunDrop" and part:IsDescendantOf(workspace) then return part end
			dropWatch.parts[part] = nil
		end
		return nil
	end

	hitbox.Position = UDim2.new(0, 14, 0, 32)
	hitbox.Size = UDim2.new(1, -28, 0, 22)
	hitbox.BackgroundTransparency = 1
	hitbox.Text = ""
	hitbox.ZIndex = 3
	hitbox.Parent = row

	local value = math.clamp(default, min, max)

	local function format(number)
		if max - min >= 10 then
			return string.format("%d", math.floor(number + 0.5))
		end
		return string.format("%.1f", number)
	end

	local function update(newValue, notify)
		value = math.clamp(newValue, min, max)
		local alpha = (value - min) / (max - min)
		fill.Size = UDim2.fromScale(alpha, 1)
		valueLabel.Text = format(value)
		if notify then
			callback(value)
		end
	end

	local function setFromX(x)
		local alpha = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		update(min + (max - min) * alpha, true)
	end

	local dragging = false
	hitbox.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging
			and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	table.insert(accentListeners, function()
		fill.BackgroundColor3 = THEME.accent
		valueLabel.TextColor3 = THEME.accent
	end)

	update(value, false)
	return row
end


	section:Note("Autofarm из внешнего MM2-хаба. Не включай одновременно со старым Autofarm на вкладке «Главная».")
	local runtimeState, motion, api, stopRuntime = FarmRuntime.install(context)
	FarmRuntime.controls(context, api)
	local roleState, stopRole = RoleFarm.install(context)
	RoleFarm.controls(context, roleState)
	local boxState, stopBoxes = BoxFarm.install(context)
	BoxFarm.controls(context, boxState)
	FarmRuntime.Webhook.install(context)
end


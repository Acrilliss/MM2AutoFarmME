				return
			end
			local ok, code = FarmRuntime.Webhook.send(state, "test")
			pcall(function() context.window:Notify({Title = translation.tr(ok and "Sent" or "Send failed"), Text = ok and "" or tostring(code),
				Kind = ok and "success" or "error", Duration = 3}) end)
		end)
	end})

local function setOpen(state)
	if isOpen == state then
		return
	end
	isOpen = state
	if state then
		root.Visible = true
		shadow.Visible = true
		if mobileButton then
			mobileButton.Visible = false
		end
		root.Size = UDim2.fromOffset(menuWidth - 28, menuHeight - 18)
		shadow.Size = UDim2.fromOffset(menuWidth + 20, menuHeight + 22)
		shadow.BackgroundTransparency = 1
		TweenService:Create(root, tweenMed, {
			Size = UDim2.fromOffset(menuWidth, menuHeight),
		}):Play()
		TweenService:Create(shadow, tweenMed, { BackgroundTransparency = 0.65 }):Play()
	else
		local tween = TweenService:Create(root, tweenMed, {
			Size = UDim2.fromOffset(menuWidth - 28, menuHeight - 18),
		})
		tween:Play()
		TweenService:Create(shadow, tweenMed, { BackgroundTransparency = 1 }):Play()
		tween.Completed:Connect(function()
			if not isOpen then
				root.Visible = false
				shadow.Visible = false
				if mobileButton then
					mobileButton.Visible = isMobile
				end
			end
		end)
	end
end


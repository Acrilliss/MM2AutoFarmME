		frame.BorderSizePixel = 0
		frame.ZIndex = 60
		frame.Parent = gui
		Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
		local stroke = Instance.new("UIStroke")
		stroke.Color = options.Kind == "error" and Color3.fromRGB(255, 96, 96)
			or (options.Kind == "success" and Color3.fromRGB(88, 214, 141) or THEME.accent)
		stroke.Thickness = 1

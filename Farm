	local state = default

	local function render()
		button.TextColor3 = state and Color3.fromRGB(255, 255, 255) or THEME.accent
		stroke.Transparency = state and 1 or 0.6
		TweenService:Create(button, tweenFast, {
			BackgroundColor3 = state and THEME.accent or THEME.surface,
		}):Play()
	end

	button.MouseEnter:Connect(function()
		if not state then
			TweenService:Create(button, tweenFast, { BackgroundColor3 = THEME.surfaceSoft }):Play()
		end
	end)
	button.MouseLeave:Connect(function()
		if not state then
			TweenService:Create(button, tweenFast, { BackgroundColor3 = THEME.surface }):Play()
		end
	end)
	button.Activated:Connect(function()
		state = not state
		render()
		callback(state)
	end)

	table.insert(accentListeners, function()
		stroke.Color = THEME.accent
		render()
	end)

	render()
	return button
end

local draggingWindow = false
